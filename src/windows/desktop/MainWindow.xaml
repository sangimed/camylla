<Window
    x:Class="Camylla.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Camylla preview">
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="6">
            <Grid>
                <TextBlock Text="Camylla" FontSize="26" FontWeight="SemiBold" />
                <Button Content="Exit Camylla" Click="OnExit" HorizontalAlignment="Right" />
            </Grid>
            <TextBlock x:Name="StateText" Text="Waiting for phone" />
            <TextBlock x:Name="RecoveryHelp" TextWrapping="Wrap" />
            <TextBlock x:Name="QualityText" TextWrapping="Wrap" />
            <Button x:Name="RetryReceiverButton" Content="Retry PC listener" Click="OnRetryReceiver" Visibility="Collapsed" />
        </StackPanel>
        <Border Grid.Row="1" Background="#FF20252B" MinHeight="360" CornerRadius="8">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" PointerPressed="OnPreviewFocus" AutomationProperties.Name="Camera preview. Click to focus; Focus centre is available in Camera controls." />
                <TextBlock x:Name="WaitingText" Text="Waiting for a phone stream"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="22" Foreground="White" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="Start capture on your paired phone." />
            <Expander Header="Camera controls">
                <ScrollViewer MaxHeight="320">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="CameraControlStatus" Text="Start capture on the phone to expose its camera controls." TextWrapping="Wrap" />
                        <StackPanel x:Name="CameraControlRows" Spacing="8" />
                    </StackPanel>
                </ScrollViewer>
            </Expander>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Pair a phone" Click="OnPair" />
                <ComboBox x:Name="TrustedPhonesBox" PlaceholderText="Trusted phones" MinWidth="240" />
                <Button Content="Revoke selected phone" Click="OnRevoke" />
            </StackPanel>
            <TextBlock x:Name="ConnectionHelp" TextWrapping="Wrap" />
            <Expander Header="Security">
                <StackPanel Spacing="8">
                    <Button x:Name="LegacyCleanupButton" Content="Remove old connection credentials" Click="OnRemoveLegacyCredentials" Visibility="Collapsed" />
                    <Button Content="Change PC key" Click="OnRotateDesktop" />
                    <TextBlock x:Name="RotationStatusText" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
        </StackPanel>
        <Expander Grid.Row="3" Header="Diagnostics">
            <TextBlock x:Name="DiagnosticsText" TextWrapping="Wrap" />
        </Expander>
        <ContentDialog x:Name="PairDialog" Title="Connect your phone" CloseButtonText="Close" Closed="OnPairClosed">
            <StackPanel Spacing="12">
                <TextBlock Text="On your phone, enter this one-time code. Camylla finds this PC on your local network. QR scan remains available as an alternative." TextWrapping="Wrap" />
                <TextBlock x:Name="PairCodeText" FontSize="30" FontWeight="SemiBold" CharacterSpacing="160" />
                <Image x:Name="PairQr" Width="280" Height="280" />
                <TextBlock x:Name="PairStatus" TextWrapping="Wrap" />
                <Button Content="Create new pairing code and QR" Click="OnPair" />
                <Expander Header="Connection options">
                    <StackPanel Spacing="8">
                        <TextBox x:Name="LanAddressBox" Header="PC LAN address" />
                        <TextBox x:Name="InvitationBox" Header="Manual invitation" IsReadOnly="True" TextWrapping="Wrap" />
                        <TextBlock x:Name="CandidateText" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
