<Window
    x:Class="Camylla.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Camylla">
    <Grid Background="{StaticResource CamyllaBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Compact application chrome: tool identity first, destructive exit separated. -->
        <Border Grid.Row="0"
                Background="{StaticResource CamyllaSurfaceBrush}"
                BorderBrush="{StaticResource CamyllaBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="CAMYLLA"
                               FontSize="16"
                               FontWeight="SemiBold"
                               CharacterSpacing="120"
                               Foreground="{StaticResource CamyllaTextBrush}" />
                    <TextBlock Text="CAMERA WORKSPACE"
                               Style="{StaticResource CamyllaSectionLabelStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Exit Camylla"
                        Click="OnExit"
                        Style="{StaticResource CamyllaDangerButtonStyle}" />
            </Grid>
        </Border>

        <!-- Preview dominates the workspace; configuration stays in a dense inspector panel. -->
        <Grid Grid.Row="1" Padding="12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource CamyllaSurfaceBrush}"
                        BorderBrush="{StaticResource CamyllaBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,9">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="STREAM STATUS" Style="{StaticResource CamyllaSectionLabelStyle}" />
                            <TextBlock x:Name="StateText"
                                       Text="Waiting for phone"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CamyllaTextBrush}" />
                            <TextBlock x:Name="RecoveryHelp"
                                       Style="{StaticResource CamyllaSecondaryTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="RetryReceiverButton"
                                Content="Retry PC listener"
                                Click="OnRetryReceiver"
                                Visibility="Collapsed"
                                Style="{StaticResource CamyllaButtonStyle}"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="Black"
                        BorderBrush="{StaticResource CamyllaBorderBrush}"
                        BorderThickness="1"
                        MinHeight="360"
                        CornerRadius="4">
                    <Grid>
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               PointerPressed="OnPreviewFocus"
                               AutomationProperties.Name="Camera preview. Click to focus; Focus centre is available in Camera controls." />
                        <TextBlock x:Name="WaitingText"
                                   Text="Waiting for a phone stream"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="{StaticResource CamyllaMutedBrush}" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           x:Name="QualityText"
                           Style="{StaticResource CamyllaSecondaryTextStyle}"
                           Margin="2,0" />
            </Grid>

            <Border Grid.Column="1"
                    Background="{StaticResource CamyllaSurfaceBrush}"
                    BorderBrush="{StaticResource CamyllaBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock Text="CAMERA" Style="{StaticResource CamyllaSectionLabelStyle}" />
                        <TextBlock Text="Live controls"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CamyllaTextBrush}" />
                        <TextBlock x:Name="CameraControlStatus"
                                   Text="Start capture on the phone to expose its camera controls."
                                   Style="{StaticResource CamyllaSecondaryTextStyle}" />
                        <Expander Header="Camera controls" IsExpanded="True">
                            <ScrollViewer MaxHeight="360">
                                <StackPanel x:Name="CameraControlRows" Spacing="8" />
                            </ScrollViewer>
                        </Expander>

                        <Border Height="1"
                                Background="{StaticResource CamyllaBorderBrush}"
                                Margin="0,2" />

                        <TextBlock Text="CONNECTION" Style="{StaticResource CamyllaSectionLabelStyle}" />
                        <Button Content="Pair a phone"
                                Click="OnPair"
                                Style="{StaticResource CamyllaPrimaryButtonStyle}" />
                        <ComboBox x:Name="TrustedPhonesBox"
                                  PlaceholderText="Trusted phones"
                                  HorizontalAlignment="Stretch" />
                        <Button Content="Revoke selected phone"
                                Click="OnRevoke"
                                Style="{StaticResource CamyllaDangerButtonStyle}" />
                        <TextBlock x:Name="ConnectionHelp"
                                   Style="{StaticResource CamyllaSecondaryTextStyle}" />

                        <Expander Header="Security">
                            <StackPanel Spacing="8">
                                <Button x:Name="LegacyCleanupButton"
                                        Content="Remove old connection credentials"
                                        Click="OnRemoveLegacyCredentials"
                                        Visibility="Collapsed"
                                        Style="{StaticResource CamyllaButtonStyle}" />
                                <Button Content="Change PC key"
                                        Click="OnRotateDesktop"
                                        Style="{StaticResource CamyllaButtonStyle}" />
                                <TextBlock x:Name="RotationStatusText"
                                           Style="{StaticResource CamyllaSecondaryTextStyle}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Diagnostics stay available without competing with the camera workspace. -->
        <Border Grid.Row="2"
                Background="{StaticResource CamyllaSurfaceBrush}"
                BorderBrush="{StaticResource CamyllaBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Expander Header="Diagnostics">
                <TextBlock x:Name="DiagnosticsText"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="{StaticResource CamyllaMutedBrush}" />
            </Expander>
        </Border>

        <ContentDialog x:Name="PairDialog"
                       Title="Connect your phone"
                       CloseButtonText="Close"
                       Closed="OnPairClosed">
            <StackPanel Spacing="12">
                <TextBlock Text="On your phone, enter this one-time code. Camylla finds this PC on your local network. QR scan remains available as an alternative."
                           TextWrapping="Wrap" />
                <TextBlock x:Name="PairCodeText"
                           FontSize="30"
                           FontWeight="SemiBold"
                           CharacterSpacing="160" />
                <Image x:Name="PairQr" Width="280" Height="280" />
                <TextBlock x:Name="PairStatus" TextWrapping="Wrap" />
                <Button Content="Create new pairing code and QR"
                        Click="OnPair"
                        Style="{StaticResource CamyllaPrimaryButtonStyle}" />
                <Expander Header="Connection options">
                    <StackPanel Spacing="8">
                        <TextBox x:Name="LanAddressBox" Header="PC LAN address" />
                        <TextBox x:Name="InvitationBox"
                                 Header="Manual invitation"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap" />
                        <TextBlock x:Name="CandidateText" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
